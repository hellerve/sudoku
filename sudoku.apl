#!/usr/bin/env dyalogscript
⎕IO←0 ⋄ D←1+⍳9

C←{
  m←9 9⍴⍺ ⋄ r c←9 9⊤⍵ ⋄ r0 c0←3×⌊(r c)÷3
  ~(D∊0~⍨∪m[r;],m[;c],,m[r0+⍳3;c0+⍳3])
}

P←{
  b←⍵ ⋄ i←⍸0=b ⋄ 0=≢i:b
  cs←↑(b∘C)¨i ⋄ l←+/cs ⋄ 0∊l:⍬
  f←l=1 ⋄ ~∨/f:b
  b[f/i]←(f⌿cs)+.×D ⋄ ∇b
}

S←{
  b←P ⍵ ⋄ 0=≢b:⍬ ⋄ ~0∊b:b
  i←⍸0=b ⋄ cs←↑(b∘C)¨i ⋄ l←+/cs ⋄ k←l⍳⌊/l ⋄ idx←i[k]
  sols←(⊂∘∇)¨({(⍵@idx)⊢b}¨cs[k;]/D)
  ⊃(((0<(≢∘⊃)¨sols)/sols),⊂⍬)
}

m←↑(
  (0 0 3 0 2 0 6 0 0)
  (9 0 0 3 0 5 0 0 1)
  (0 0 1 8 0 6 4 0 0)
  (0 0 8 1 0 2 9 0 0)
  (7 0 0 0 0 0 0 0 8)
  (0 0 6 7 0 8 2 0 0)
  (0 0 2 6 0 9 5 0 0)
  (8 0 0 2 0 3 0 0 9)
  (0 0 5 0 1 0 3 0 0)
)
p←,m
⎕←9 9⍴S p
